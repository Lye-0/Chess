rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedManager() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isManagerOrganization(organizationId) {
      return isVerifiedManager() &&
        exists(/databases/$(database)/documents/managers/$(request.auth.uid)/organizations/$(organizationId));
    }

    match /managers/{managerUid} {
      allow read, write: if isVerifiedManager() && request.auth.uid == managerUid;

      match /organizations/{organizationId} {
        allow read: if isVerifiedManager() && request.auth.uid == managerUid;
        allow create: if isVerifiedManager() &&
          request.auth.uid == managerUid &&
          request.resource.data.organizationId == organizationId &&
          getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.createdBy == request.auth.uid;
        allow update, delete: if isVerifiedManager() &&
          request.auth.uid == managerUid &&
          isManagerOrganization(organizationId);
      }
    }

    match /organizations/{organizationId} {
      allow create: if isVerifiedManager() &&
        request.resource.data.createdBy == request.auth.uid;
      allow read, update, delete: if isManagerOrganization(organizationId);

      match /employees/{employeeId} {
        allow read, write: if isManagerOrganization(organizationId);
      }

      match /shiftSlots/{slotId} {
        allow read, write: if isManagerOrganization(organizationId);
      }

      match /shiftRequests/{requestId} {
        allow read, write: if isManagerOrganization(organizationId);
      }

      match /compatibilities/{employeeId} {
        allow read, write: if isManagerOrganization(organizationId);
      }

      match /settings/{settingId} {
        allow read, write: if isManagerOrganization(organizationId);
      }
    }
  }
}
