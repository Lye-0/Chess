[debug] [2026-07-14T17:53:11.037Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/chess-64d14:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isVerifiedManager() {\r\n      return isSignedIn() && request.auth.token.email_verified == true;\r\n    }\r\n\r\n    function isManagerOrganization(organizationId) {\r\n      return isVerifiedManager() &&\r\n        exists(/databases/$(database)/documents/managers/$(request.auth.uid)/organizations/$(organizationId));\r\n    }\r\n\r\n    match /managers/{managerUid} {\r\n      allow read, write: if isVerifiedManager() && request.auth.uid == managerUid;\r\n\r\n      match /organizations/{organizationId} {\r\n        allow read: if isVerifiedManager() && request.auth.uid == managerUid;\r\n\r\n        allow update, delete: if isVerifiedManager() &&\r\n          request.auth.uid == managerUid &&\r\n          isManagerOrganization(organizationId);\r\n      }\r\n    }\r\n\r\n    match /organizations/{organizationId} {\r\n\r\n      allow read, update, delete: if isManagerOrganization(organizationId);\r\n\r\n      match /employees/{employeeId} {\r\n        allow read, write: if isManagerOrganization(organizationId);\r\n      }\r\n\r\n      match /shiftSlots/{slotId} {\r\n        allow read, write: if isManagerOrganization(organizationId);\r\n      }\r\n\r\n      match /shiftRequests/{requestId} {\r\n        allow read, write: if isManagerOrganization(organizationId);\r\n      }\r\n\r\n      match /compatibilities/{employeeId} {\r\n        allow read, write: if isManagerOrganization(organizationId);\r\n      }\r\n\r\n      match /positions/{positionId} {\r\n        allow read, write: if isManagerOrganization(organizationId);\r\n      }\r\n\r\n      match /settings/{settingId} {\r\n        allow read, write: if isManagerOrganization(organizationId);\r\n      }\r\n    }\r\n  }\r\n}\r\n"}]}}
